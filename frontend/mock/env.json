 "sql": "-- 練習資料庫：電子廠 ERP / MES（SQLite）\n-- 刻意放了：NULL、重複料號採購、對不到的外鍵、沒有下過單的供應商、還沒結案的工單\n\nCREATE TABLE suppliers (\n  supplier_id INTEGER PRIMARY KEY,\n  name        TEXT NOT NULL,\n  city        TEXT,\n  rating      TEXT            -- A/B/C，NULL = 尚未評鑑\n);\nINSERT INTO suppliers VALUES\n (1,'台光電材','桃園','A'),\n (2,'南亞銅箔','新北','A'),\n (3,'長興化工','高雄','B'),\n (4,'華通零件','新竹','B'),\n (5,'聯茂電子','桃園',NULL),\n (6,'宏泰包材','台中','C'),\n (7,'金居開發','嘉義','B'),\n (8,'新創模具','桃園',NULL);   -- 從沒被採購過\n\nCREATE TABLE materials (\n  material_id  TEXT PRIMARY KEY,   -- 料號\n  name         TEXT NOT NULL,\n  category     TEXT,               -- 原料/化學品/零件/包材\n  unit         TEXT,\n  unit_cost    REAL,\n  supplier_id  INTEGER,            -- 主要供應商\n  safety_stock INTEGER,\n  stock_qty    INTEGER\n);\nINSERT INTO materials VALUES\n ('RM-001','FR4 基板','原料','片',120.0,1,500,820),\n ('RM-002','銅箔 1oz','原料','捲',3500.0,2,20,12),\n ('RM-003','銅箔 2oz','原料','捲',5200.0,2,10,10),\n ('RM-004','預浸材 PP','原料','捲',2800.0,5,15,30),\n ('CH-001','防焊油墨','化學品','kg',450.0,3,100,60),\n ('CH-002','顯影液','化學品','L',80.0,3,200,450),\n ('CH-003','蝕刻液','化學品','L',95.0,NULL,300,280),\n ('PT-001','連接器 20pin','零件','個',12.5,4,2000,5400),\n ('PT-002','電容 0402','零件','個',0.3,4,50000,38000),\n ('PT-003','驅動 IC','零件','個',85.0,7,1000,NULL),\n ('PK-001','防靜電袋','包材','個',1.2,6,5000,12000),\n ('PK-002','真空包裝箱','包材','個',35.0,6,300,150),\n ('PK-003','乾燥劑','包材','包',0.8,99,3000,4100),   -- 供應商 99 不存在\n ('RM-005','玻璃基板 G6','原料','片',900.0,1,200,260),\n ('CH-004','光阻劑','化學品','L',1300.0,5,40,40);\n\nCREATE TABLE purchase_orders (\n  po_id         TEXT PRIMARY KEY,\n  material_id   TEXT REFERENCES materials(material_id),\n  supplier_id   INTEGER REFERENCES suppliers(supplier_id),\n  qty           INTEGER,\n  unit_price    REAL,\n  order_date    TEXT,     -- YYYY-MM-DD\n  due_date      TEXT,\n  received_date TEXT,     -- NULL = 還沒到貨\n  status        TEXT      -- 開立/部分到貨/結案/取消\n);\nINSERT INTO purchase_orders VALUES\n ('PO2609001','RM-001',1,1000,118.0,'2026-09-02','2026-09-12','2026-09-11','結案'),\n ('PO2609002','RM-002',2,30,3450.0,'2026-09-05','2026-09-20','2026-09-25','結案'),\n ('PO2609003','CH-001',3,200,440.0,'2026-09-08','2026-09-18','2026-09-18','結案'),\n ('PO2609004','PT-001',4,5000,12.0,'2026-09-10','2026-09-25','2026-09-24','結案'),\n ('PO2609005','PK-001',6,10000,1.1,'2026-09-15','2026-09-22','2026-09-22','結案'),\n ('PO2609006','RM-002',2,20,3500.0,'2026-09-28','2026-10-10','2026-10-15','結案'),\n ('PO2610001','RM-001',1,800,120.0,'2026-10-01','2026-10-11','2026-10-10','結案'),\n ('PO2610002','CH-002',3,500,78.0,'2026-10-03','2026-10-10','2026-10-09','結案'),\n ('PO2610003','PT-002',4,60000,0.28,'2026-10-06','2026-10-20','2026-10-21','結案'),\n ('PO2610004','RM-004',5,25,2750.0,'2026-10-08','2026-10-22','2026-10-22','結案'),\n ('PO2610005','PT-003',7,1500,82.0,'2026-10-12','2026-10-30',NULL,'取消'),\n ('PO2610006','CH-004',5,50,1280.0,'2026-10-15','2026-10-29','2026-11-05','結案'),\n ('PO2610007','RM-005',1,300,890.0,'2026-10-18','2026-11-01','2026-10-31','結案'),\n ('PO2610008','PK-002',6,400,34.0,'2026-10-20','2026-10-30','2026-10-30','結案'),\n ('PO2610009','RM-002',2,25,3480.0,'2026-10-25','2026-11-08','2026-11-12','結案'),\n ('PO2611001','RM-003',2,15,5150.0,'2026-11-02','2026-11-16',NULL,'開立'),\n ('PO2611002','CH-001',3,150,455.0,'2026-11-04','2026-11-14','2026-11-14','結案'),\n ('PO2611003','PT-001',4,3000,12.5,'2026-11-06','2026-11-20',NULL,'部分到貨'),\n ('PO2611004','RM-001',1,1200,119.0,'2026-11-10','2026-11-20','2026-11-19','結案'),\n ('PO2611005','PT-003',7,1200,84.0,'2026-11-12','2026-11-26',NULL,'開立'),\n ('PO2611006','PK-003',99,5000,0.75,'2026-11-15','2026-11-22','2026-11-22','結案'),\n ('PO2611007','CH-002',3,400,NULL,'2026-11-18','2026-11-25',NULL,'開立'),  -- 單價還沒填\n ('PO2611008','RM-004',5,20,2780.0,'2026-11-20','2026-12-04',NULL,'開立'),\n ('PO2611009','RM-002',2,30,3520.0,'2026-11-22','2026-12-06',NULL,'開立');\n\nCREATE TABLE work_orders (\n  wo_id      TEXT PRIMARY KEY,\n  product    TEXT,        -- 產品料號\n  line       